// CostQuest: Unity to the Android app. TEMPLATE for ubmids/costquest-unity.
//
// Save as Assets/Scripts/Native/CQAndroidBridge.cs (any runtime folder, NOT an
// Editor folder) in costquest-unity, then call it next to every place that
// reaches the iOS app today. On iOS those are the C functions of
// Assets/Plugins/iOS/CQNativeBridge.m, called through [DllImport("__Internal")]
// (the app registers its callbacks with CQSet*Callback). On Android there is
// no C symbol to call: Unity calls static Java methods of the app instead.
//
// The receiving class is in the app, always present (also in builds without
// Unity) and kept by R8:
//   modules/costquest-game/android/src/main/java/expo/modules/costquestgame/unity/CQUnityEvents.kt
//
//   iOS callback (CQNativeBridge.m)   Android (this file)            app event onUnityEvent
//   anchor tapped                      CQAndroidBridge.AnchorTapped   world / anchorTapped
//   checkpoint tapped                  CQAndroidBridge.CheckpointTapped world / checkpointTapped
//   world ready (buildings)            CQAndroidBridge.WorldReady     world / ready
//   duel event (kind, json)            CQAndroidBridge.DuelEvent      duel / kind
//   hub event (kind, json)             CQAndroidBridge.HubEvent       hub / kind
//   battle event (kind, json)          CQAndroidBridge.BattleEvent    battle / kind
// Kinds: ready, sfx, finished, quit (FRAMEWORK_PIN.md "bridge contract").
//
// The app to Unity direction needs NO change: Android uses
// UnityPlayer.UnitySendMessage(gameObject, method, arg), the same
// GameObject/method names as iOS (DuelBridge.StartDuel/DemoDuel/Quit,
// BattleBridge.*, HubBridge.*, WorldRoot.*).
//
// Typical change at each call site, e.g. in DuelBridge.cs:
//
//   #if UNITY_IOS && !UNITY_EDITOR
//       CQDuelEvent(kind, json);              // existing [DllImport("__Internal")]
//   #elif UNITY_ANDROID && !UNITY_EDITOR
//       CQAndroidBridge.DuelEvent(kind, json);
//   #endif
//
// Threading: these run on Unity's main thread (not Android's UI thread); the
// app's receiver is thread-safe. AttachCurrentThread is automatic for
// AndroidJavaClass calls from Unity's main thread.
using UnityEngine;

public static class CQAndroidBridge
{
#if UNITY_ANDROID && !UNITY_EDITOR
    const string ReceiverClass = "expo.modules.costquestgame.unity.CQUnityEvents";
    static AndroidJavaClass receiver;

    static void Call(string method, params object[] args)
    {
        try
        {
            if (receiver == null) receiver = new AndroidJavaClass(ReceiverClass);
            receiver.CallStatic(method, args);
        }
        catch (System.Exception e)
        {
            // An app without the receiver (e.g. Unity's own launcher project)
            // must not crash the game.
            Debug.LogWarning("[CQAndroidBridge] " + method + " failed: " + e.Message);
        }
    }

    public static void AnchorTapped(string id) => Call("anchorTapped", id ?? "");
    public static void CheckpointTapped(string id) => Call("checkpointTapped", id ?? "");
    public static void WorldReady(int buildings) => Call("worldReady", buildings);
    public static void DuelEvent(string kind, string json) => Call("duelEvent", kind ?? "", json ?? "");
    public static void HubEvent(string kind, string json) => Call("hubEvent", kind ?? "", json ?? "");
    public static void BattleEvent(string kind, string json) => Call("battleEvent", kind ?? "", json ?? "");
#else
    // Editor and other platforms: no app to tell.
    public static void AnchorTapped(string id) { }
    public static void CheckpointTapped(string id) { }
    public static void WorldReady(int buildings) { }
    public static void DuelEvent(string kind, string json) { }
    public static void HubEvent(string kind, string json) { }
    public static void BattleEvent(string kind, string json) { }
#endif
}
